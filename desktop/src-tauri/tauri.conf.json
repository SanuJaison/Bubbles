{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bubbles",
  "version": "1.0.3",
  "identifier": "com.bubbles.chat",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev -- --port 5173",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../fallback"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bubbles",
    "copyright": "Copyright (c) 2026 Bubbles",
    "category": "SocialNetworking",
    "shortDescription": "Bubbles desktop chat app",
    "longDescription": "Chat with friends and groups, send voice messages, make calls, share files, and use AI-assisted replies from the Bubbles desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
