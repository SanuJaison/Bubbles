# Google OAuth Web Client ID (same value as backend GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=

# Backend API base URL. Include the /api suffix.
# Production example: https://bubbles-api.example.com/api
VITE_API_URL=http://localhost:3000/api

# Socket.IO server origin (no /api suffix).
# Production example: https://bubbles-api.example.com
VITE_SOCKET_URL=http://localhost:3000

# Optional direct download links for the Windows installer and Android APK.
# Leave blank until the builds are published. The landing page shows a
# "Coming soon" state when these are empty.
VITE_WINDOWS_DOWNLOAD_URL=
VITE_ANDROID_DOWNLOAD_URL=
